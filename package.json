{
  "name": "paycheck-guard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "npm run theme:check && npm run debt && tsc --noEmit && vite build",
    "build:calc20": "tsc --noEmit && vite build --config vite.calc20.config.ts",
    "flatten": "node scripts/flatten.mjs",
    "preview": "vite preview",
    "state": "node scripts/state.mjs",
    "typecheck": "tsc --noEmit",
    "theme:check": "node scripts/theme-check.mjs",
    "debt": "node scripts/design-debt.mjs",
    "debt:update": "node scripts/design-debt.mjs --update",
    "review": "node scripts/review-report.mjs",
    "review:check": "node scripts/review-report.mjs --check",
    "layouts": "node scripts/layouts.mjs",
    "words": "node scripts/words.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "^1.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
